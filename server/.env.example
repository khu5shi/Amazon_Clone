NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/amazon_enterprise
JWT_SECRET=super_secret_jwt_key_for_amazon_enterprise_2026
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=150
AUTH_RATE_LIMIT_MAX=10

# Root Admin Credentials
ADMIN_EMAIL=admin@amazon.com
ADMIN_PASSWORD=admin123

# Gmail / SMTP Mailer Configuration
# Enter your real Gmail address and 16-character Google App Password (https://myaccount.google.com/apppasswords)
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Amazon Enterprise <no-reply@amazon-enterprise.dev>

# OTP Expiration in seconds (60 seconds)
OTP_EXPIRES_SECONDS=60

# DPDP Grievance Officer
DPDP_GRIEVANCE_OFFICER_NAME=Rahul Sharma
DPDP_GRIEVANCE_OFFICER_EMAIL=grievance-officer@amazon-enterprise.dev
